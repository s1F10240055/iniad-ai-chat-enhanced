+"use strict";
+Object.defineProperty(exports, "__esModule", { value: true });
+const zod_1 = require("zod");
+const zod_to_json_schema_1 = require("zod-to-json-schema");
+
+const LOGIN_MARKERS = [
+  "Google アカウントにログイン",
+  "Sign in",
+  "accounts.google.com",
+];
+
+function parsePresentationId(url) {
+  const match = url.match(/\/presentation\/d\/(?:e\/)?([^/]+)/);
+  return match ? match[1] : null;
+}
+
+function toPubUrl(presentationId, embedUrl) {
+  const isPublished = embedUrl.includes("/d/e/") || presentationId.startsWith("2PACX");
+  if (isPublished) {
+    return `https://docs.google.com/presentation/d/e/${presentationId}/pub?start=false&loop=false&delayms=3000`;
+  }
+  return `https://docs.google.com/presentation/d/${presentationId}/pub?start=false&loop=false&delayms=3000`;
+}
+
+function isLoginWall(text) {
+  return LOGIN_MARKERS.some((m) => text.includes(m));
+}
+
+/** ブラウザ内で実行: 現在スライドの aria-label 本文を収集 */
+function extractSlideLabelsInBrowser() {
+  const NOISE = [
+    /^Shift[+＋]/,
+    /^⌘/,
+    /^Ctrl[+＋]/,
+    /^Alt[+＋]/,
+    /^[A-Z]$/,
+    /^Copyright ©/i,
+    /^From: https?:\/\//i,
+    /C:\\Users\\/i,
+    /\.bmp$/i,
+  ];
+
+  const isNoise = (label) => {
+    const t = label.trim();
+    if (t.length < 6) return true;
+    return NOISE.some((p) => p.test(t));
+  };
+
+  const slideInfo =
+    document.querySelector('[aria-label^="スライド"]')?.getAttribute("aria-label") || "";
+
+  const gLabels = Array.from(document.querySelectorAll("g[aria-label]"))
+    .map((e) => (e.getAttribute("aria-label") || "").replace(/\u000b/g, "\n").trim())
+    .filter((l) => !isNoise(l));
+
+  return {
+    slideInfo,
+    labels: [...new Set(gLabels)],
+  };
+}
+
+const extractGoogleSlideTextTool = {
+  schema: {
+    name: "extractGoogleSlideText",
+    description:
+      "Extracts text from Google Slides embedded on the current MOOCs slide page via aria-labels in the published viewer.",
+    inputSchema: (0, zod_to_json_schema_1.zodToJsonSchema)(zod_1.z.object({})),
+  },
+  capability: "core",
+  async handle(context) {
+    try {
+      const tab = await context.ensureTab();
+      const page = tab.page;
+      const moocsUrl = page.url();
+
+      const iframeLocator = page.locator('iframe[src*="docs.google.com/presentation"]');
+      const iframeCount = await iframeLocator.count();
+      if (iframeCount === 0) {
+        return {
+          content: [
+            {
+              type: "text",
+              text: JSON.stringify({
+                error: "no_google_slides_iframe",
+                moocsUrl,
+                hint: "Call expandSlideTab on a MOOCs slide page first.",
+              }),
+            },
+          ],
+          isError: true,
+        };
+      }
+
+      const src = await iframeLocator.first().getAttribute("src");
+      if (!src) {
+        return {
+          content: [{ type: "text", text: JSON.stringify({ error: "iframe_src_missing", moocsUrl }) }],
+          isError: true,
+        };
+      }
+
+      const embedUrl = new URL(src, moocsUrl).href;
+      const presentationId = parsePresentationId(embedUrl);
+      if (!presentationId) {
+        return {
+          content: [
+            { type: "text", text: JSON.stringify({ error: "presentation_id_not_found", embedUrl, moocsUrl }) },
+          ],
+          isError: true,
+        };
+      }
+
+      const pubUrl = toPubUrl(presentationId, embedUrl);
+      const browserContext = page.context();
+      const slidePage = await browserContext.newPage();
+
+      try {
+        await slidePage.goto(pubUrl, { waitUntil: "domcontentloaded", timeout: 45_000 });
+        await slidePage.waitForSelector('[aria-label^="スライド"]', { timeout: 20_000 }).catch(() => {});
+        await slidePage.waitForTimeout(2000);
+
+        const probe = await slidePage.evaluate(extractSlideLabelsInBrowser);
+        const totalMatch = probe.slideInfo.match(/スライド \d+\/(\d+)/);
+        const totalSlides = totalMatch ? Math.min(parseInt(totalMatch[1], 10), 30) : 15;
+
+        const allSlides = [];
+        const seenKeys = new Set();
+
+        for (let i = 0; i < totalSlides; i++) {
+          const current = await slidePage.evaluate(extractSlideLabelsInBrowser);
+          const key = current.slideInfo || current.labels.join("|");
+          if (!seenKeys.has(key)) {
+            seenKeys.add(key);
+            if (current.labels.length > 0 || current.slideInfo) {
+              allSlides.push({
+                heading: current.slideInfo.replace(/^スライド \d+\/\d+:\s*/, ""),
+                labels: current.labels,
+              });
+            }
+          }
+          await slidePage.keyboard.press("ArrowRight");
+          await slidePage.waitForTimeout(600);
+        }
+
+        const textParts = [];
+        for (const slide of allSlides) {
+          const body = slide.labels.join("\n").trim();
+          if (!body) continue;
+          const header = slide.heading ? `## ${slide.heading}` : "";
+          textParts.push(header ? `${header}\n${body}` : body);
+        }
+        let combined = textParts.join("\n\n---\n\n").trim();
+        const MAX_COMBINED_CHARS = 6_000;
+        if (combined.length > MAX_COMBINED_CHARS) {
+          combined = combined.slice(0, MAX_COMBINED_CHARS) + "\n...(truncated)";
+        }
+
+        // ログイン壁ではスライド本文(aria-label)が空になることがあるため、
+        // ページ本文も含めてログインマーカーを検出する（empty 判定より前で）
+        const bodyText = await slidePage
+          .evaluate(() => document.body?.innerText || "")
+          .catch(() => "");
+        if (isLoginWall(combined) || isLoginWall(bodyText)) {
+          return {
+            content: [
+              {
+                type: "text",
+                text: JSON.stringify({
+                  error: "google_login_required",
+                  moocsUrl,
+                  presentationId,
+                  pubUrl,
+                }),
+              },
+            ],
+            isError: true,
+          };
+        }
+
+        if (!combined || combined.length < 40) {
+          return {
+            content: [
+              {
+                type: "text",
+                text: JSON.stringify({
+                  error: "empty_slide_text",
+                  moocsUrl,
+                  presentationId,
+                  pubUrl,
+                  slideCount: allSlides.length,
+                  charCount: combined.length,
+                }),
+              },
+            ],
+            isError: true,
+          };
+        }
+
+        return {
+          content: [
+            {
+              type: "text",
+              text: JSON.stringify({
+                moocsUrl,
+                presentationId,
+                pubUrl,
+                slideCount: allSlides.length,
+                charCount: combined.length,
+                text: combined,
+              }),
+            },
+          ],
+        };
+      } finally {
+        await slidePage.close().catch(() => {});
+      }
+    } catch (error) {
+      const errorMessage = error instanceof Error ? error.message : String(error);
+      return {
+        content: [{ type: "text", text: `extractGoogleSlideText failed: ${errorMessage}` }],
+        isError: true,
+      };
+    }
+  },
+};
+
+exports.default = [extractGoogleSlideTextTool];
