+"use strict";
+Object.defineProperty(exports, "__esModule", { value: true });
+const zod_1 = require("zod");
+const zod_to_json_schema_1 = require("zod-to-json-schema");
+const LoginInputSchema = zod_1.z.object({});
+function toGoogleEmail(username) {
+    const trimmed = (username || '').trim();
+    if (!trimmed)
+        return '';
+    return trimmed.includes('@') ? trimmed : `${trimmed}@iniad.org`;
+}
+const googleLoginTool = {
+    schema: {
+        name: 'loginToGoogleWithIniadAccount',
+        description: 'Logs in to Google with INIAD account credentials (INIAD_USERNAME as @iniad.org email, INIAD_PASSWORD). Skips if already logged in.',
+        inputSchema: (0, zod_to_json_schema_1.zodToJsonSchema)(LoginInputSchema),
+    },
+    capability: 'core',
+    async handle(context) {
+        const username = process.env.INIAD_USERNAME;
+        const password = process.env.INIAD_PASSWORD;
+        if (!username || !password) {
+            return {
+                content: [{ type: 'text', text: 'Error: INIAD_USERNAME and INIAD_PASSWORD must be set.' }],
+                isError: true,
+            };
+        }
+        const email = toGoogleEmail(username);
+        try {
+            const tab = await context.ensureTab();
+            const page = tab.page;
+            await page.goto('https://accounts.google.com/', { waitUntil: 'domcontentloaded' });
+            await page.waitForTimeout(1000);
+            const url = page.url();
+            if (url.includes('myaccount.google.com') || url.includes('mail.google.com')) {
+                return { content: [{ type: 'text', text: 'Already logged in to Google.' }] };
+            }
+            const emailInput = page.locator('input[type="email"], input[name="identifier"]');
+            if (await emailInput.isVisible({ timeout: 5000 }).catch(() => false)) {
+                await emailInput.fill(email);
+                const nextBtn = page.locator('button:has-text("次へ"), button:has-text("Next"), #identifierNext');
+                await nextBtn.first().click();
+                await page.waitForTimeout(1500);
+            }
+            const passwordInput = page.locator('input[type="password"], input[name="Passwd"]');
+            await passwordInput.waitFor({ state: 'visible', timeout: 10000 });
+            await passwordInput.fill(password);
+            const loginBtn = page.locator('button:has-text("次へ"), button:has-text("Next"), #passwordNext');
+            await loginBtn.first().click();
+            await page.waitForURL(/myaccount\.google\.com|mail\.google\.com|google\.com\/account/, { timeout: 30000 }).catch(async () => {
+                const current = page.url();
+                if (current.includes('challenge') || current.includes('signin/v2/challenge')) {
+                    throw new Error('Google 2FA required. Log in manually in Playwright profile (see README).');
+                }
+            });
+            return { content: [{ type: 'text', text: `Google login succeeded for ${email}` }] };
+        }
+        catch (error) {
+            const errorMessage = error instanceof Error ? error.message : String(error);
+            return {
+                content: [{ type: 'text', text: `Google login failed: ${errorMessage}` }],
+                isError: true,
+            };
+        }
+    },
+};
+exports.default = [googleLoginTool];
